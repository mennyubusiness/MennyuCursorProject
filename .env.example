# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public origin (required in production) — no trailing slash
PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# Auth.js / NextAuth (min 32 chars)
AUTH_SECRET=change-me-min-32-chars-for-auth-js-sessions
# Signed customer order SMS/status links (min 32 chars; may match AUTH_SECRET)
ORDER_ACCESS_SIGNING_SECRET=
# Vendor dashboard magic links (min 32 chars; required in production)
VENDOR_ACCESS_SIGNING_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (transactional SMS — Messaging Service required for live send)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional: override delivery status callback (default: {PUBLIC_APP_URL}/api/twilio/sms-status)
# TWILIO_STATUS_CALLBACK_URL=https://your-domain.com/api/twilio/sms-status
# Legacy From number — not used when TWILIO_MESSAGING_SERVICE_SID is set
# TWILIO_FROM_PHONE_NUMBER=

# SMS behavior (primary control)
# SMS_MODE=log       — record attempts in SmsMessageLog, do not call Twilio (safe default for dev)
# SMS_MODE=twilio    — live send via Messaging Service (production launch)
# SMS_MODE=disabled  — suppress all outbound SMS
SMS_MODE=log
# Legacy (used when SMS_MODE is unset):
# SMS_ENABLED=false
# SMS_DRY_RUN=true
# SMS_LOG_ONLY=false

# Email (password recovery)
# Development: keep EMAIL_DRY_RUN=true to log reset links instead of sending
EMAIL_ENABLED=true
EMAIL_DRY_RUN=true
# RESEND_API_KEY=
# EMAIL_FROM=Open Order <noreply@yourdomain.com>

# Deliverect
# ROUTING_MODE=mock          # default — no live POS submission
# ROUTING_MODE=deliverect    # live submission (production launch)
# DELIVERECT_ENV=production  # or staging with ALLOW_DELIVERECT_STAGING_WEBHOOKS=true on preview hosts
# DELIVERECT_WEBHOOK_AUTH_MODE=channel_link  # default — HMAC uses Vendor.deliverectChannelLinkId
# DELIVERECT_WEBHOOK_AUTH_MODE=partner_secret  # legacy — requires DELIVERECT_WEBHOOK_SECRET below
# DELIVERECT_WEBHOOK_SECRET=   # only when partner_secret auth mode
# DELIVERECT_API_URL=
# DELIVERECT_CLIENT_ID=
# DELIVERECT_CLIENT_SECRET=

# Production-only overrides (see docs/PRODUCTION_CONFIG.md)
# ALLOW_ROUTING_MODE_MOCK=true
# ALLOW_DELIVERECT_STAGING_WEBHOOKS=true

# Admin bridge (optional; platform admin session preferred)
# ADMIN_SECRET=
# Admin QA tools (simulate routing failure, etc.) — off in production unless enabled:
# ENABLE_ADMIN_TEST_TOOLS=true

# Legacy REST cart line mutations (off by default; UI uses cart.actions)
# ENABLE_CART_API_MUTATIONS=true
# INTERNAL_JOB_SECRET=
# CRON_SECRET=

# Rate limiting (see docs/RATE_LIMITING.md)
# RATE_LIMIT_DISABLED=1
